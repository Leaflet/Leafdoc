{
  "name": "leafdoc",
  "version": "2.3.0",
  "description": "A lightweight NaturalDocs-like LeafletJS-style documentation generator",
  "type": "module",
  "exports": "./src/leafdoc.js",
  "author": "Iván Sánchez Ortega <ivan@sanchezortega.es>",
  "license": "GPL-3.0",
  "bin": {
    "leafdoc": "src/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "templates"
  ],
  "dependencies": {
    "handlebars": "^4.7.6",
    "markdown-it": "^11.0.0",
    "minimist": "^1.2.5",
    "multilang-extract-comments": "^0.3.3",
    "regenerate-unicode-properties": "^8.2.0",
    "xregexp": "^4.3.0"
  },
  "scripts": {
    "update-markdown-leafdoc": "src/cli.js -t templates/markdown src/cli.js src/leafdoc.js --verbose -o Leafdoc.md",
    "update-html-leafdoc": "src/cli.js -t templates/basic src/leafdoc.js src/cli.js --verbose -o Leafdoc.html",
    "prepublishOnly": "npm run update-markdown-leafdoc && npm run update-html-leafdoc",
    "test": "jasmine",
    "lint": "eslint src/ spec/*.js",
    "lintfix": "eslint src/ spec/*.js --fix"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Leaflet/Leafdoc.git"
  },
  "devDependencies": {
    "eslint": "^7.4.0",
    "eslint-config-mourner": "^3.0.0",
    "eslint-plugin-jasmine": "^4.1.1",
    "jasmine": "^5.1.0"
  },
  "eslintConfig": {
    "extends": "mourner",
    "plugins": [
      "jasmine"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "prefer-arrow-callback": 0,
      "indent": [
        1,
        "tab",
        {
          "VariableDeclarator": 0,
          "flatTernaryExpressions": true
        }
      ]
    }
  }
}
